function mergeRevisionPerformance(local,remote){
 const a=local&&typeof local==='object'?local:{},b=remote&&typeof remote==='object'?remote:{};
 const questions={...(a.questions||{})};
 for(const [id,rr] of Object.entries(b.questions||{})){
  const lr=questions[id]||{},r=rr||{},latest=(Number(r.lastAt)||0)>=(Number(lr.lastAt)||0)?r:lr;
