याय- गौतम","योग — कपिल","पूर्व मीमांसा — जैमनीय","उत्तर मीमांसा—बादरायण"],"answer":1},{"q":"प्रश्न 1577. वेदांत दर्शन में ‘प्रस्थानत्रयी’ में कौन-सा ग्रंथ शामिल नहीं है?","en":"","options":["उपनिषद","भगवद्गीता","ब्रह्मसूत्र","योगसूत्र"],"answer":3},{"q":"प्रश्न 1578. वेदांत दर्शन में ‘तत्त्वमसि’ महावाक्य किस मत से विशेष रूप से जुड़ा है?","en":"","options":["द्वैत","विशिष्टाद्वैत","अद्वैत","न्याय"],"answer":2},{"q":"प्रश्न 1579. निम्न में से कौन-सा महावाक्य अद्वैत से संबंधित है?","en":"","options":["अहं ब्रह्मास्मि","तत्त्वमसि","प्रज्ञानं ब्रह्म","उपरोक्त सभी"],"answer":3},{"q":"प्रश्न 1580. निम्न में से कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["अद्वैत — माया से युक्त प्रतीति","विशिष्टाद्वैत — वास्तविक किन्तु ब्रह्म पर आश्रित","द्वैत — पूर्णतः सत्य और स्वतंत्र","अद्वैत — जगत को परम सत्य मानना"],"answer":3},{"q":"प्रश्न 1581. निम्न में से कौन-सा युग्म  सुमेलित नहीं है?","en":"","options":["अद्वैत — आदि शंकराचार्य","विशिष्टाद्वैत — रामानुजाचार्य","द्वैत — मध्वाचार्य","अद्वैत — रामानुजाचार्य"],"answer":3},{"q":"प्रश्न 1582. निम्न में से कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["तत्त्वमसि — छांदोग्य उपनिषद","अहं ब्रह्मास्मि — बृहदारण्यक उपनिषद","प्रज्ञानं ब्रह्म — ऐतरेय उपनिषद","अयम् आत्मा ब्रह्म — केन उपनिषद"],"answer":3},{"q":"प्रश्न 1583. निम्न में से कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["अयम् आत्मा ब्रह्म — माण्डूक्य उपनिषद","सर्व खल्विदं ब्रम्ह — छांदोग्य उपनिषद","प्रज्ञानं ब्रह्म — बृहदारण्यक उपनिषद","अहं ब्रह्मास्मि — बृहदारण्यक उपनिषद"],"answer":2},{"q":"प्रश्न 1584. निम्न में से कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["अयम् आत्मा ब्रह्म — अथर्वेद","तत्त्वमसि — सामवेद","प्रज्ञानं ब्रह्म — अथर्ववेद","अहं ब्रह्मास्मि — यजुर्वेद"],"answer":2},{"q":"प्रश्न 1585. निम्न में से कौन-सा युग्म सही सुमेलित नहीं है?","en":"","options":["अद्वैतवाद — शंकराचार्य","विशिष्टाद्वैतवाद — रामानुजाचार्य","द्वैताद्वैतवाद — निम्बार्काचार्य","शुद्धाद्वैतवाद — मध्वाचार्य"],"answer":3},{"q":"प्रश्न 1586. निम्न में से कौन-सा सुमेलित नहीं है?","en":"","options":["द्वैतवाद — मध्वाचार्य","भेदाभेदवाद — भास्कराचार्य","शैव विशिष्टाद्वैत — श्रीकंठ","अचिन्त्य भेदाभेदवाद — रामानुजाचार्य"],"answer":3},{"q":"प्रश्न 1587. निम्न में से कौन-सा युग्म असंगत है?","en":"","options":["वीर शैव विशिष्टाद्वैत — श्रीपति","अविभागाद्वैत — विज्ञान भिक्षु","अचिन्त्य भेदाभेदवाद — चैतन्य महाप्रभु","विशिष्टाद्वैतवाद — शंकराचार्य"],"answer":2},{"q":"प्रश्न 1588. “पृथ्वी सूक्त भूमि के महत्व को स्पष्ट करने वाला कदाचित वह पहला संदर्भ है, जहाँ एक व्यक्ति भूमि को अपनी माता कहता है।”यह सूक्त किस वेद से संबंधित है ?","en":"","options":["ऋग्वेद","यजुर्वेद","सामवेद","अथर्ववेद"],"answer":3},{"q":"प्रश्न 1589. नालंदा विश्वविद्यालय की स्थापना कब हुई थी ?","en":"","options":["तीसरी सदी ई.पू.","पाँचवीं सदी ई.","सातवीं सदी ई.","आठवीं सदी ई."],"answer":1},{"q":"प्रश्न 1590. नालंदा में पीतल की चद्दरों से निर्मित मठ का निर्माण किसने करवाया था ?","en":"","options":["अशोक","पुष्यमित्र शुंग","कनिष्क","हर्षवर्धन"],"answer":3},{"q":"प्रश्न 1591. जावा के किस राजवंश के राजा ने पाल राजा देवपाल के पास नालंदा में मठ की स्थापना हेतु पाँच गाँवों का अनुदान माँगने के लिए राजदूत भेजा था ?","en":"","options":["मलय राजवंश","कादि राजवंश","शैलेन्द्र राजवंश","केदु राजवंश"],"answer":2},{"q":"प्रश्न 1592. किस संहिता में रुद्र-शिव को समस्त लोकों का स्वामी बताया गया है?","en":"","options":["तैत्तिरीय संहिता","वाजसनेयी संहिता","ऐतरेय संहिता","कौषीतकी संहिता"],"answer":1},{"q":"प्रश्न 1593. किस ग्रंथ में रुद्र-शिव को भव, शर्व, पशुपति, भूपति, उग्र, महादेव तथा एक व्रात कहा गया है?","en":"","options":["ऋग्वेद","सामवेद","अथर्ववेद","यजुर्वेद"],"answer":2},{"q":"प्रश्न 1594. शिव के आठ रूपों का उल्लेख किन ब्राह्मण ग्रंथों में किया गया है?","en":"","options":["ऐतरेय एवं कौषीतकी","तैत्तिरीय एवं पंचविंश","कौषीतक एवं शतपथ","गोपथ एवं जैमिनीय"],"answer":2},{"q":"प्रश्न 1595. किस उपनिषद में शिव-भक्ति का प्रथम एवं स्पष्ट वर्णन किया गया है?","en":"","options":["कठ उपनिषद","श्वेताश्वर उपनिषद","ईशोपनिषद","मुण्डक उपनिषद"],"answer":1},{"q":"प्रश्न 1596. शैव धर्म में शिव-शक्ति के संयुक्त रूप ‘अर्धनारीश्वर