"","options":["जूनागढ़ अभिलेख","ऐहोल अभिलेख","नानाघाट अभिलेख","बादामी शिलालेख"],"answer":1},{"q":"प्रश्न 1691. किस अभिलेख में पुलकेशिन प्रथम को ‘वातापिपुर रूपी वधू का स्वामी’ कहा गया है?","en":"","options":["बादामी शिलालेख","ऐहोल अभिलेख","जूनागढ़ अभिलेख","अयोध्या अभिलेख"],"answer":1},{"q":"प्रश्न 1692. किस अभिलेख में कालिदास एवं भारवि का उल्लेख मिलता है?","en":"","options":["जूनागढ़ अभिलेख","ऐहोल अभिलेख","देवपाड़ा प्रशस्ति","हाथीगुफ़ा अभिलेख"],"answer":1},{"q":"प्रश्न 1693. ऐहोल अभिलेख के सम्बंध में निम्नलिखित कथनों में से कौन सा कथन असत्य है?","en":"","options":["इसमें महाभारत के बाद की कालगणना है।","इसमें कालिदास व भारवि का उल्लेख है","यह पुलकेशिन द्वितीय से संबंधित है।","यह प्राकृत भाषा में है।"],"answer":3},{"q":"प्रश्न 1694. पट्टदकल अभिलेख किस चालुक्य शासक से संबंधित है?","en":"","options":["पुलकेशिन प्रथम","पुलकेशिन द्वितीय","विक्रमादित्य","कीर्तिवर्मन"],"answer":2},{"q":"प्रश्न 1695. हरहा अभिलेख के रचयिता कौन थे?","en":"","options":["बाणभट्ट","रविशांति","हरिषेण","कालिदास"],"answer":1},{"q":"प्रश्न 1696. कमौली लेख किस गहड़वाल शासक से संबंधित है?","en":"","options":["जयचन्द्र","गोविन्दचन्द्र","चन्द्रदेव","मदनपाल"],"answer":1},{"q":"प्रश्न 1697. निम्नलिखित युग्मों में से कौन सा सुमेलित नहीं है?","en":"","options":["वाकाटक वंश — रिद्धपुर ताम्रपत्र","राष्ट्रकूट वंश — राधनपुर लेख","पाल वंश — खालिमपुर अभिलेख","परमार वंश — कमौली लेख"],"answer":3},{"q":"प्रश्न 1698. निम्नलिखित युग्मों में से कौन सा सुमेलित नहीं है?","en":"","options":["कल्याणी के चालुक्य — कैथोल लेख","राष्ट्रकूट — संजन ताम्रपत्र","पाल वंश — सांगली अभिलेख","वाकाटक वंश- पूना अभिलेख"],"answer":2},{"q":"प्रश्न 1699. निम्नलिखित अभिलेख–शासक युग्मों में से कौन सा सुमेलित नहीं है?","en":"","options":["जूनागढ़ अभिलेख — रुद्रदामन","ऐहोल अभिलेख — पुलकेशिन द्वितीय","नानाघाट अभिलेख — शातकर्णि प्रथम","संगौली अभिलेख —धर्मपाल"],"answer":3},{"q":"प्रश्न 1700. निम्नलिखित अभिलेख–शासक युग्मों में से कौन सा सुमेलित नहीं है?","en":"","options":["खालिमपुर अभिलेख — धर्मपाल","राधनपुर लेख — गोविन्द तृतीय","बादामी शिलालेख — पुलकेशिन प्रथम","पट्टदकल अभिलेख — पुलकेशिन द्वितीय"],"answer":3},{"q":"प्रश्न 1701. निम्नलिखित अभिलेख–शासक युग्मों में से कौन सा सुमेलित नहीं है?","en":"","options":["कैथोल अभिलेख — विक्रमादित्य VI","कमौली लेख — विग्रहराज","सांगली लेख — गोविंद चतुर्थ","संजन ताम्रपत्र — अमोघवर्ष प्रथम"],"answer":1},{"q":"प्रश्न 1702. नालन्दा अभिलेख किस पाल शासक से संबंधित है?","en":"","options":["देवपाल","गोपाल","धर्मपाल","विग्रहपाल"],"answer":0},{"q":"प्रश्न 1703. हरहा अभिलेख से किस वंश के विषय में जानकारी मिलती है?","en":"","options":["गुप्त वंश","मौखरी वंश","चालुक्य वंश","राष्ट्रकूट वंश"],"answer":1},{"q":"प्रश्न 1704. ‘चन्द्रेल्ल’ शब्द का प्रयोग किस शिलालेख में हुआ है?","en":"","options":["देवगढ़ प्रस्तर शिलालेख","दुढ़ई शिलालेख","बनारस शिलालेख","मदनपुर प्रस्तर लेख"],"answer":0},{"q":"प्रश्न 1705. सिक्कों पर ‘महाराज’ की उपाधि का सर्वप्रथम प्रयोग किस यवन शासक की मुद्राओं पर हुआ?","en":"","options":["यूक्रेटाइडिज","मेनांडर","डेमेट्रियस","एंटियाल्किडस"],"answer":0},{"q":"प्रश्न 1706. भारतीय अभिलेखों में ‘महाराज’ की उपाधि का सर्वप्रथम प्रयोग किस अभिलेख में मिलता है?","en":"","options":["जूनागढ़ अभिलेख","हाथीगुम्फा अभिलेख","सांची अभिलेख","नानाघाट अभिलेख"],"answer":1},{"q":"प्रश्न 1707. सर्वप्रथम किस अभिलेख से युद्ध में जहाजों के प्रयोग की सूचना मिलती है?","en":"","options":["जूनागढ़ अभिलेख","हाथीगुम्फा अभिलेख","सांची अभिलेख","ऐहोल अभिलेख"],"answer":1},{"q":"प्रश्न 1708. पहलव शासक गोंडोफर्नीज का तख्त-ए-बाही अभिलेख किस लिपि में है?","en":"","options":["ब्राह्मी","खरोष्ठी","ग्रीक","नागरी"],"answer":1},{"q":"प्रश्न 1709. किस अभिलेख में ग्राम पंचायत का उल्लेख मिलता है?","en":"","options":["ऐहोल अभिलेख","सांची अभिलेख","भीतरी स्तंभलेख","खालिमपुर अभिलेख"],"answer":1},{"q":"प्रश्न 1710. किस अभिलेख में विष्णु मंदिर निर्माण हेतु ‘ग्राम दान’ का उल्लेख मिलता है?","en":"","options":["जूनागढ़ अभिलेख","भीतरी स्तंभलेख","ऐहोल अभिलेख","प्रयाग प्रशस्ति"],"answer":1},{"q":"प्रश्न 1711. किस अभिलेख से बौद्ध धर्म से संबंधित दानात्मक प्रमाण प्राप्त होते हैं?","en":"","options":["जलघट अभिलेख","हाथीगुम्फा अभिलेख","नानाघट अभिलेख","भागलपुर अभिलेख"],"answer":0},{"q":"प्रश्न 1712. सर्वप्रथम शून्य का अभिलेखीय साक्ष्य किस अभिलेख में प्राप्त होता है?","en":"","options":["ग्वालियर अभिलेख में","प्रयाग प्रशस्ति में","नासिक अभिलेख में","गिरनार अभिलेख में"],"answer":0},{"q":"प्रश्न 1713. अश्वमेध यज्ञ की सूचना देने वाला प्रथम अभिलेख कौन सा है?","en":"","options":["हाथीगुंफा अभिलेख","अयोध्या अभिलेख","हरहा अभिलेख","गिरनार अभिलेख"],"answer":1},{"q":"प्रश्न 1714. कन्नड़ भाषा का प्रथम अभिलेख किसे माना जाता है?","en":"","options":["ऐहोल अभिलेख","बादामी शिलालेख","ग्वालियर अभिलेख","मंदसौर अभिलेख"],"answer":1},{"q":"प्रश्न 1715. सती प्रथा का प्रथम साक्ष्य किस अभिलेख में प्राप्त होता है?","en":"","options":["एरण अभिलेख","नासिक अभिलेख","हाथीगुंफा अभिलेख","गिरनार अभिलेख"],"answer":0},{"q":"प्रश्न 1716. महासामंत एवं सामंत शब्दों का प्रथम उल्लेख किस अभिलेख में मिलता है?","en":"","options":["प्रयाग प्रशस्ति","गुणधर अभिलेख","ऐहोल अभिलेख","तंजौर अभिलेख"],"answer":1},{"q":"प्रश्न 1717. सात शास्त्रीय रागों के स्वरों की व्याख्या किस अभिलेख में मिलती है?","en":"","options":["कोषुम अभिलेख","कुडुमियामलाई अभिलेख","मणिमेखले अभिलेख","उरयूर अभिलेख"],"answer":1},{"q":"प्रश्न 1718. जूनागढ़ अभिलेख में किस शासक को जनता द्वारा निर्वाचित शासक बताया गया है?","en":"","options":["धर्मपाल","रुद्रदामन","अशोक","चंद्रगुप्त मौर्य"],"answer":1},{"q":"प्रश्न 1719. एरण अभिलेख (510 ई.) किस शासक के काल से संबंधित है?","en":"","options":["चंद्रगुप्त द्वितीय","भानुगुप्त","स्कंदगुप्त","कुमारगुप्त"],"answer":1},{"q":"प्रश्न 1720. सर्वाधिक राजस्व शब्दावलियों का उल्लेख किस चोल शासक के अभिलेख में मिलता है?","en":"","options":["राजराज प्रथम","राजेंद्र द्वितीय","कुलोत्तुंग प्रथम","परांतक प्रथम"],"answer":1},{"q":"प्रश्न 1721. राजकीय अभिलेखों के आरंभ में ऐतिहासिक भूमिका (प्राक्कथन) देने की परंपरा किस चोल शासक ने प्रारंभ की?","en":"","options":["राजराज प्रथम","राजेंद्र प्रथम","कुलोत्तुंग प्रथम","आदित्य प्रथम"],"answer":0},{"q":"प्रश्न 1722. मंदसौर अभिलेख किस शासक से संबंधित है?","en":"","options":["यशोधर्मन","बंधुवर्मन","कुमारगुप्त","तोरमाण"],"answer":0},{"q":"प्रश्न 1723. सिंचाई के साधन के रूप में रहट का उल्लेख सर्वप्रथम किस अभिलेख में मिलता है?","en":"","options":["हाथीगुंफा अभिलेख","मंदसौर अभिलेख","जूनागढ़ अभिलेख","भीतरी  अभिलेख"],"answer":1},{"q":"प्रश्न 1724. सर्वप्रथम स्वर्ण सिक्का जारी करने वाले हिन्द-यवन शासक कौन थे?","en":"","options":["डेमेट्रियस","मेनांडर","यूक्रेटाइड्स","एंटियाल्किडास"],"answer":1},{"q":"प्रश्न 1725. कुषाण शासकों में भारत में सर्वप्रथम स्वर्ण सिक्का चलाने का श्रेय किसे दिया जाता है?","en":"","options":["कनिष्क","हुविष्क","विम कडफिसेस","वासुदेव"],"answer":2},{"q":"प्रश्न 1726. गुप्त शासकों में सर्वप्रथम स्वर्ण सिक्का चलाने का श्रेय किसे दिया जाता है?","en":"","options":["समुद्रगुप्त","चंद्रगुप्त प्रथम","कुमारगुप्त","स्कंदगुप्त"],"answer":1},{"q":"प्रश्न 1727. त्रिपुरी के किस कलचुरी शासक ने स्वर्ण सिक्के जारी किए थे?","en":"","options":["कोकल्लदेव","गंगेयदेव","लक्ष्मीकर्ण","यशःकर्ण"],"answer":1},{"q":"प्रश्न 1728. आहत मुद्राओं के संबंध में निम्नलिखित कथनों पर विचार कीजिए और असत्य कथन का चयन कीजिए—","en":"","options":["ये भारतीय उपमहाद्वीप के प्रारंभिक सिक्के थे।","ये अधिकांशतः चांदी से निर्मित थे","इन पर विविध प्रतीक चिह्न अंकित होते थे।","ये गुप्त काल मे प्रचलित थे"],"answer":3},{"q":"प्रश्न 1729. आहत सिक्कों पर सामान्यतः किसका अंकन अनिवार्य रूप से मिलता है?","en":"","options":["चंद्रमा","सूर्य","शंख","शिव"],"answer":1},{"q":"प्रश्न 1730. रजत शतमान का प्राचीनतम उल्लेख किस ग्रंथ में मिलता है?","en":"","options":["ऋग्वेद","मैत्रायणी संहिता","अथर्ववेद","शतपथ ब्राह्मण"],"answer":1},{"q":"प्रश्न 1731. कार्षापण का प्रथम उल्लेख किस ग्रंथ में हुआ है?","en":"","options":["ऐतरेय ब्राह्मण","सामविधान ब्राह्मण","शतपथ ब्राह्मण","तैत्तिरीय संहिता"],"answer":1},{"q":"प्रश्न 1732. सीसा एवं पोटीन के सिक्के किस वंश के शासकों ने चलाए?","en":"","options":["कुषाण","सातवाहन","गुप्त","शुंग"],"answer":1},{"q":"प्रश्न 1733. सीसे की मुद्राओं का प्रचलन किस इंडो-ग्रीक शासक ने किया था?","en":"","options":["मेनांडर","डेमेट्रियस","स्ट्रेटो द्वितीय","यूक्रेटाइड्स"],"answer":2},{"q":"प्रश्न 1734. अपोलोडोटस के सिक्कों पर सर्वप्रथम किस धर्म के चिह्न मिलते हैं?","en":"","options":["बौद्ध धर्म","जैन धर्म","शैव धर्म","भागवत धर्म"],"answer":3},{"q":"प्रश्न 1735. सर्वप्रथम सिक्कों पर लेख लिखवाने का कार्य किस शासक वर्ग ने प्रारंभ किया था?","en":"","options":["मौर्य शासकों ने","शुंग शासकों ने","हिन्द-यवन शासकों ने","सातवाहन शासकों ने"],"answer":2},{"q":"प्रश्न 1736. भारत में सर्वप्रथम द्विभाषी एवं द्विलिपीय सिक्कों का प्रचलन किस हिन्द-यवन शासक ने किया था?","en":"","options":["मेनांडर","डेमेट्रियस द्वितीय","एंटिमेकस","अपोलोडोटस"],"answer":1},{"q":"प्रश्न 1737. हिन्द-यवन शासकों के चाँदी के सिक्कों को क्या कहा जाता था?","en":"","options":["दीनार","द्रम्म","टंका","पण"],"answer":1},{"q":"प्रश्न 1738. हिन्द-यवन शासकों के स्वर्ण सिक्कों को क्या कहा जाता था?","en":"","options":["दीनार","द्रम्म","स्टेटर","कार्षापण"],"answer":2},{"q":"प्रश्न 1739. वर्गाकार (चौकोर) मुद्रा का प्रवर्तक करने वाला हिन्द यवन शासक कौन था?","en":"","options":["मेनांडर","एंटिमेकस प्रथम","यूक्रेटाइड्स","अपोलोडोटस"],"answer":1},{"q":"प्रश्न 1740. भारत मे सर्वप्रथम सोने के सिक्के जारी करने वाला शासक कौन थे ?","en":"","options":["मौर्य शासकों ने","शुंग शासकों ने","हिन्द-यवन शासकों ने","सातवाहन शासकों ने"],"answer":2},{"q":"प्रश्न 1741. हिंद यवन शासकों द्वारा जारी सिक्कों के संबंध में निम्न में से कौन सा कथन असत्य है?","en":"","options":["स्वर्ण सिक्के ‘स्टेटर’ कहलाते थे।","चाँदी के सिक्के ‘द्रम्म’ कहलाते थे।","सिक्कों पर शासक की आकृति मिलती है।","सिक्कों पर लेख नहीं मिलते।"],"answer":3},{"q":"प्रश्न 1742. सर्वाधिक मात्रा में सीसे के सिक्के किस वंश ने चलाए?","en":"","options":["कुषाणों ने","सातवाहनों ने","गुप्तों ने","शकों ने"],"answer":1},{"q":"प्रश्न 1743. सातवाहनों में सर्वप्रथम किस शासक ने अवाक्ष प्रकार के सिक्के चलाए?","en":"","options":["सिमुक","गौतमीपुत्र शातकर्णि","पुलुमावी","यज्ञश्री शातकर्णि"],"answer":1},{"q":"प्रश्न 1744. हूण शासक तोरमाण की मुद्राओं पर कौन-सी उपाधि अंकित मिलती है?","en":"","options":["देवपुत्र","महाराजाधिराज","शाही-जुवल","परमभागवत"],"answer":2},{"q":"प्रश्न 1745. हूण शासक मिहिरकुल के सिक्कों पर किसका अंकन मिलता है?","en":"","options":["गरुड़ एवं लक्ष्मी","नंदी एवं त्रिशूल","चक्र एवं सूर्य","अश्व एवं शंख"],"answer":1},{"q":"प्रश्न 1746. शक-सातवाहन काल में स्वर्ण-रजत सिक्कों का अनुपात कितना था?","en":"","options":["1 : 14","1 : 16","1 : 20","1 : 35"],"answer":3},{"q":"प्रश्न 1747. गुप्त काल में स्वर्ण-रजत सिक्कों का अनुपात कितना था?","en":"","options":["1 : 14","1 : 16","1 : 35","1 : 10"],"answer":1},{"q":"प्रश्न 1748. शक–कुषाण काल में स्वर्ण–रजत सिक्कों का अनुपात कितना था?","en":"","options":["1 : 35","1 : 14","1 : 16","1 : 10"],"answer":1},{"q":"प्रश्न 1749. प्रतिहार नरेश भोज ने किस उपाधि को धारण कर उसी शैली के सिक्के जारी किए?","en":"","options":["परमभागवत","आदिवाराह","महाराजाधिराज","देवपुत्र"],"answer":1},{"q":"प्रश्न 1750. अपने सिक्कों पर सर्वप्रथम शिव, नंदी एवं त्रिशूल का अंकन किस कुषाण शासक ने कराया?","en":"","options":["कनिष्क","हुविष्क","विम कडफिसेस","वासुदेव"],"answer":2},{"q":"प्रश्न 1751. सिक्कों पर सर्वप्रथम उमा का अंकन किस कुषाण नरेश ने कराया?","en":"","options":["कनिष्क","हुविष्क","विम कडफिसेस","वासुदेव"],"answer":1},{"q":"प्रश्न 1752. मयूर आकृति वाले सिक्के किस गुप्त शासक के हैं?","en":"","options":["चंद्रगुप्त प्रथम","समुद्रगुप्त","कुमारगुप्त","स्कंदगुप्त"],"answer":2},{"q":"प्रश्न 1753. लक्ष्मी का अंकन किस गुप्त शासक के सिक्कों पर मिलता है?","en":"","options":["समुद्रगुप्त","स्कंदगुप्त","चंद्रगुप्त द्वितीय","कुमारगुप्त"],"answer":1},{"q":"प्रश्न 1754. गुप्त संवत का सर्वप्रथम प्रयोग किस शासक के अभिलेख में मिलता है?","en":"","options":["चंद्रगुप्त प्रथम","समुद्रगुप्त","चंद्रगुप्त द्वितीय","कुमारगुप्त"],"answer":2},{"q":"प्रश्न 1755. 319 A.D. में किस गुप्त शासक ने गुप्त संवत का प्रचलन किया?","en":"","options":["समुद्रगुप्त","चंद्रगुप्त प्रथम","कुमारगुप्त","स्कंदगुप्त"],"answer":1},{"q":"प्रश्न 1756. शक संवत और विक्रम संवत के बीच कितने वर्षों का अंतर है?","en":"","options":["100 वर्ष","135 वर्ष","241 वर्ष","57 वर्ष"],"answer":1},{"q":"प्रश्न 1757. 78 A.D. में किस शासक द्वारा शक संवत शुरू किया गया था?","en":"","options":["चंद्रगुप्त प्रथम","कनिष्क","समुद्रगुप्त","विक्रमादित्य"],"answer":1},{"q":"प्रश्न 1758. 57 B.C. में मालवा के शासक विक्रमादित्य ने शकों को पराजित कर कौन-सा संवत चलाया?","en":"","options":["शक संवत","गुप्त संवत","विक्रम संवत","कलि संवत"],"answer":2},{"q":"प्रश्न 1759. भारत का प्राचीनतम संवत कौन-सा माना जाता है?","en":"","options":["विक्रम संवत","शक संवत","कलि संवत","गुप्त संवत"],"answer":2},{"q":"प्रश्न 1760. निम्नलिखित में से कौन सा कथन असत्य है?","en":"","options":["विक्रम और शक संवत में 57 वर्ष का अंतर है","विक्रम संवत 57 B.C. से प्रारंभ हुआ।","शक संवत 78 A.D. में प्रारंभ हुआ।","गुप्त संवत 319 A.D. में प्रारंभ हुआ।"],"answer":0},{"q":"प्रश्न 1761. मालव संवत किस अन्य नाम से भी जाना जाता है?","en":"","options":["शक संवत","वीर निर्वाण संवत","कलि संवत","कृत संवत"],"answer":3},{"q":"प्रश्न 1762. शकों पर विजय प्राप्त करने के बाद चंद्रगुप्त द्वितीय ने किस धातु के सिक्के प्रचलित किए?","en":"","options":["स्वर्ण","चाँदी","तांबा","काँसा"],"answer":1},{"q":"प्रश्न 1763. 248 A.D. में कलचुरी-चेदि संवत का प्रचलन किसने किया?","en":"","options":["कोक्कल प्रथम","ईश्वरसेन","गांगेयदेव","लक्ष्मीकर्ण"],"answer":1},{"q":"प्रश्न 1764. 1583 ई. में इलाही संवत की शुरुआत किसने की?","en":"","options":["अकबर","जहाँगीर","औरंगजेब","शेरशाह"],"answer":0},{"q":"प्रश्न 1765. 1674 ई में राज शक संवत का प्रचलन किसने किया?","en":"","options":["शिवाजी","बाजीराव","पेशवा बालाजी","औरंगजेब"],"answer":0},{"q":"प्रश्न 1766. ‘राजतरंगिणी’ का विस्तार जैनुल आबिदीन के काल में किसने किया?","en":"","options":["कल्हण","जयनक","जोनराज","बिल्हण"],"answer":2},{"q":"प्रश्न 1767. ‘राजतरंगिणी’ का फारसी अनुवाद किसने कराया?","en":"","options":["अकबर","औरंगजेब","शाहजहाँ","मुहम्मद शाह"],"answer":3},{"q":"प्रश्न 1768. राजतरंगिणी के सम्बंध में निम्नलिखित में से कौन सा कथन असत्य है?","en":"","options":["इसकी रचना कल्हण ने की।","यह संस्कृत भाषा में लिखी गई।","‘राजतरंगिणी’ में कुल 10 तरंगें हैं।","इसमें कश्मीर के शासकों का वर्णन है"],"answer":2},{"q":"प्रश्न 1769. कल्हण ने कश्मीर के प्रथम शासक के रूप में किसका उल्लेख किया?","en":"","options":["ललितादित्य","हर्ष","अशोक","जयसिंह"],"answer":2},{"q":"प्रश्न 1770. कल्हण के पिता चम्पक किस कश्मीरी नरेश के मंत्री थे?","en":"","options":["हर्ष","जयसिंह","अवन्तिवर्मन","ललितादित्य"],"answer":0},{"q":"प्रश्न 1771. ‘राजतरंगिणी’ में अंतिम वर्णित शासक कौन था?","en":"","options":["जयसिंह","हर्ष","ललितादित्य","अवन्तिवर्मन"],"answer":0},{"q":"प्रश्न 1772. होयसाल स्थापत्य कला के प्रमुख उदाहरण किन स्थानों से प्राप्त होते हैं?","en":"","options":["तंजावुर, मदुरै, कांची","हेलबीड़, वेलूर, सोमनाथपुर","बादामी, ऐहोल, पट्टडकल","हम्पी, विजयपुर, गुलबर्गा"],"answer":1},{"q":"प्रश्न 1773. हेलबीड़ के होयसलेश्वर मंदिर का निर्माण किसके शासनकाल में हुआ था?","en":"","options":["वीर बल्लाल द्वितीय","नरसिंह प्रथम","विष्णुवर्धन","वीर बल्लाल चतुर्थ"],"answer":1},{"q":"प्रश्न 1774. वेलूर के चेन्नकेशव मंदिर का निर्माण किसके शासनकाल में हुआ था?","en":"","options":["वीर बल्लाल द्वितीय","नरसिंह द्वितीय","विष्णुवर्धन","हरिहर प्रथम"],"answer":2},{"q":"प्रश्न 1775. सोमनाथपुर के केशव मंदिर का निर्माण किस होयसाल शासक के शासनकाल में हुआ था?","en":"","options":["वीर बल्लाल द्वितीय","नरसिंह द्वितीय","नरसिंह प्रथम","वीर बल्लाल चतुर्थ"],"answer":1},{"q":"प्रश्न 1776. ‘चोलराज्य-प्रतिष्ठापनाचार्य’ की उपाधि किसने धारण की थी?","en":"","options":["वीर बल्लाल द्वितीय","नरसिंह द्वितीय","विष्णुवर्धन","वीर बल्लाल चतुर्थ"],"answer":1},{"q":"प्रश्न 1777. होयसल वंश का संस्थापक विष्णुवर्धन किस आचार्य के प्रभाव से वैष्णव हो गया था?","en":"","options":["शंकराचार्य","रामानुज","बसव","माध्वाचार्य"],"answer":1},{"q":"प्रश्न 1778. देवगिरि के यादव शासक रामचंद्रदेव के दरबारी लेखक जिसने ‘संगीत रत्नाकर’ की रचना की?","en":"","options":["बिल्हण","जयनक","सारंगदेव","चम्पक"],"answer":2},{"q":"प्रश्न 1779. चोलकालीन चित्रकला में दक्षिणामूर्ति शिव के भित्ति-चित्र कहाँ अंकित हैं?","en":"","options":["कैलाशनाथ मंदिर","बृहदीश्वर मंदिर","नागेश्वर मंदिर","सोमनाथपुर मंदिर"],"answer":1},{"q":"प्रश्न 1780. चोलकाल में धातुमूर्ति कला के लिए कौन-सा स्थान प्रसिद्ध था?","en":"","options":["कांची","मदुरै","तंजौर","बेलूर"],"answer":2},{"q":"प्रश्न 1781. नटराज (शिव) की कांस्य प्रतिमा किस कला की उत्कृष्ट कृति मानी जाती है?","en":"","options":["गुप्त कला","चोल कला","पल्लव कला","चालुक्य कला"],"answer":1},{"q":"प्रश्न 1782. किस पल्लव शासक ने सर्वप्रथम शिलाओं में उत्खनित मंदिर निर्माण कर ‘चेतकारी विक्रम’ की उपाधि धारण की थी?","en":"","options":["महेंद्रवर्मन प्रथम","नरसिंहवर्मन प्रथम","परमेश्वरवर्मन प्रथम","नंदिवर्मन"],"answer":0},{"q":"प्रश्न 1783. बृहदीश्वर मंदिर कहाँ स्थित है?","en":"","options":["कांची","मदुरै","तंजौर","बेलूर"],"answer":2},{"q":"प्रश्न 1784. गंगैकोंडचोलपुरम् मंदिर कहाँ स्थित है?","en":"","options":["कावेरी तट पर","कृष्णा तट पर","गोदावरी तट पर","तुंगभद्रा तट पर"],"answer":0},{"q":"प्रश्न 1785. गंगैकोंडचोलपुरम् मंदिर किस शैली का उदाहरण है?","en":"","options":["नागर","द्रविड़","वेसर","इंडो इस्लामिक शैली"],"answer":1},{"q":"प्रश्न 1786. गंगैकोंडचोलपुरम् मंदिर का निर्माण किसने कराया?","en":"","options":["राजराज प्रथम","राजेंद्र प्रथम","कुलोत्तुंग द्वितीय","विक्रम चोल"],"answer":1},{"q":"प्रश्न 1787. बृहदीश्वर मंदिर का निर्माण किसने कराया?","en":"","options":["राजेंद्र प्रथम","राजराज प्रथम","कुलोत्तुंग प्रथम","नरसिंहवर्मन"],"answer":1},{"q":"प्रश्न 1788. वृहदीश्वर मंदिर के संबंध में निम्नलिखित में से कौन सा कथन असत्य है?","en":"","options":["यह मंदिर तंजौर में स्थित है।","इसका निर्माण राजराज प्रथम ने कराया।","यह नागर शैली का उत्कृष्ट उदाहरण है।","यह ग्रेनाइट पत्थरों से निर्मित है।"],"answer":2},{"q":"प्रश्न 1789. बृहदीश्वर मंदिर किस धर्म से संबंधित है?","en":"","options":["वैष्णव","शैव","जैन","बौद्ध"],"answer":1},{"q":"प्रश्न 1790. निम्नलिखित में से कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["चिदम्बरम मंदिर — कुलोत्तुंग प्रथम","एरावतेश्वर मंदिर — राजराज द्वितीय","कम्पहरेश्वर मंदिर — कुलोत्तुंग द्वितीय","वृहदीश्वर मंदिर — राजेंद्र द्वितीय"],"answer":3},{"q":"प्रश्न 1791. तमिल विद्वान जयनौंदार किस चोल शासक के राजकवि थे?","en":"","options":["राजराज प्रथम","राजेंद्र प्रथम","कुलोत्तुंग प्रथम","कुलोत्तुंग द्वितीय"],"answer":2},{"q":"प्रश्न 1792. ‘वीर शोलियम’ के रचयिता कौन थे?","en":"","options":["जयनौंदार","बुद्धमित्र","शेक्किलार","पुलगोंदि"],"answer":1},{"q":"प्रश्न 1793. ‘जीवक चिन्तामणि’ के रचयिता कौन थे?","en":"","options":["तिरुत्तकदेवर","कम्बन","बुद्धमित्र","जयनौंदार"],"answer":0},{"q":"प्रश्न 1794. तमिल रामायण  ‘रामावतारम्’ की रचना किसने की थी?","en":"","options":["शेक्किलार","जयनौंदार","कम्बन","तिरुत्तकदेवर"],"answer":2},{"q":"प्रश्न 1795. ‘पेरियपुराणम्’ के लेखक कौन थे?","en":"","options":["तिरुत्तकदेवर","शेक्किलार","तोलामोलि","पुलगोंदिन"],"answer":1},{"q":"प्रश्न 1796. ‘कलिंगतुपाणी के रचयिता कौन थे?","en":"","options":["कम्बन","जयन्नगोन्दनार","पुलगोंदि","बुद्धमित्र"],"answer":1},{"q":"प्रश्न 1797. चोल कलाकारों के विषय में “देवताओं के समान कल्पना और जौहरियों के समान उसे पूर्ण किया” यह कथन किसने कहा?","en":"","options":["नीलकंठ शास्त्री","पर्सी ब्राउन","फर्ग्युसन","हावेल"],"answer":2},{"q":"प्रश्न 1798. भारत की विशालतम नंदी प्रतिमा किस मंदिर परिसर में स्थित है?","en":"","options":["गंगैकोंडचोलपुरम् मंदिर","कैलासनाथ मंदिर","बृहदीश्वर मंदिर","मीनाक्षी मंदिर"],"answer":2},{"q":"प्रश्न 1799. गंगैकोंडचोलपुरम् के शिव मंदिर को “गीतों की तरह संवेदना उत्पन्न करने वाला महान कलात्मक निर्माण” किसने कहा?","en":"","options":["नीलकंठ शास्त्री","फर्ग्युसन","पर्सी ब्राउन","हावेल"],"answer":2},{"q":"प्रश्न 1800. द्रविड़ मंदिर स्थापत्य का सर्वाधिक महत्वपूर्ण लक्षण क्या है?","en":"","options":["गोपुरम","मंडप","गर्भगृह","शिखर"],"answer":0},{"q":"प्रश्न 1801. कुलोत्तुंग द्वितीय किस धर्म का अनुयायी था?","en":"","options":["वैष्णव धर्म","जैन धर्म","बौद्ध धर्म","शैव धर्म"],"answer":3},{"q":"प्रश्न 1802. किस चोल शासक ने चिदम्बरम् के नटराज मंदिर परिसर से गोविन्दराज (विष्णु) की प्रतिमा को समुद्र में फेंकवा दिया था?","en":"","options":["राजराज प्रथम","कुलोत्तुंग प्रथम","कुलोत्तुंग द्वितीय","राजेंद्र प्रथम"],"answer":2},{"q":"प्रश्न 1803. प्रसिद्ध तमिल साहित्यकार ‘कम्बन’ को किस चोल शासक का संरक्षण प्राप्त था?","en":"","options":["राजराज प्रथम","कुलोत्तुंग द्वितीय","विक्रम चोल","राजराज द्वितीय"],"answer":1},{"q":"प्रश्न 1804. तमिल साहित्य में ‘मुत्तमिल कुत्तालियन’ (तमिल संरक्षक) की उपाधि किस चोल शासक को दी गई है?","en":"","options":["राजराज द्वितीय","कुलोत्तुंग द्वितीय","विक्रम चोल","राजेंद्र प्रथम"],"answer":0},{"q":"प्रश्न 1805. इतिहासकार नीलकंठ शास्त्री ने किसके शासनकाल को चोल साम्राज्य का सर्वाधिक रचनात्मक काल माना है?","en":"","options":["राजेंद्र प्रथम","कुलोत्तुंग प्रथम","राजराज प्रथम","विक्रम चोल"],"answer":2},{"q":"प्रश्न 1806. राजराज प्रथम के युद्ध अभियानों का क्रमिक विवरण किस अभिलेख में मिलता है?","en":"","options":["प्रयाग अभिलेख","तंजौर अभिलेख","हाथीगुम्फा अभिलेख","ऐहोल अभिलेख"],"answer":1},{"q":"प्रश्न 1807. ‘पंडित चोल’ की उपाधि किसे प्राप्त थी?","en":"","options":["राजराज प्रथम","राजेंद्र प्रथम","कुलोत्तुंग द्वितीय","विक्रम चोल"],"answer":1},{"q":"प्रश्न 1808. 13वीं शताब्दी के किस चीनी यात्री ने चोल युगीन न्याय-व्यवस्था का उल्लेख किया है?","en":"","options":["फाह्यान","ह्वेनसांग","चाउ-चु-कुआ","इत्सिंग"],"answer":2},{"q":"प्रश्न 1809. चोलों की उत्पत्ति का विवरण किस स्रोत से प्राप्त होता है?","en":"","options":["तंजौर अभिलेख","तिरुवालंगाडु प्रशस्ति","महावंश","ऐहोल अभिलेख"],"answer":1},{"q":"प्रश्न 1810. ‘महावंश’ से किस चोल शासक की लंका विजय का विवरण मिलता है?","en":"","options":["राजराज प्रथम","राजेंद्र प्रथम","कुलोत्तुंग प्रथम","विक्रम चोल"],"answer":1},{"q":"प्रश्न 1811. राजाधिराज प्रथम का मणिमंगलम् अभिलेख किस घटना का उल्लेख करता है?","en":"","options":["पांड्य विजय","अश्वमेध यज्ञ","सिंहल विजय","गंगा विजय"],"answer":1},{"q":"प्रश्न 1812. तिरुवालंगाडु ताम्रपत्र में किस चोल शासक की सिंहल विजय का उल्लेख मिलता है?","en":"","options":["परांतक प्रथम","राजराज प्रथम","राजेंद्र प्रथम","कुलोत्तुंग प्रथम"],"answer":1},{"q":"प्रश्न 1813. उत्तरमेरूर अभिलेख किस चोल शासक के काल से संबंधित है?","en":"","options":["राजराज प्रथम","परांतक प्रथम","राजेंद्र प्रथम","कुलोत्तुंग प्रथम"],"answer":1},{"q":"प्रश्न 1814. ‘तिरुवालंगाडु ताम्रपत्र’ में किस चोल शासक की सिंहल विजय का उल्लेख मिलता है?","en":"","options":["परांतक प्रथम","राजराज प्रथम","राजेंद्र प्रथम","सुंदर चोल"],"answer":1},{"q":"प्रश्न 1815. राजकीय अभिलेखों के आरंभ में ऐतिहासिक भूमिका देने की परंपरा किसने प्रारंभ की?","en":"","options":["राजेंद्र प्रथम","परांतक प्रथम","राजराज प्रथम","सुंदर चोल"],"answer":2},{"q":"प्रश्न 1816. परांतक प्रथम किस धर्म का अनुयायी था?","en":"","options":["वैष्णव धर्म","बौद्ध धर्म","जैन धर्म","शैव धर्म"],"answer":3},{"q":"प्रश्न 1817. तंजौर में दुर्गादेवी (निशुंभसुदिनी) का मंदिर किसने बनवाया था?","en":"","options":["आदित्य प्रथम","विजयालय","परांतक प्रथम","राजेंद्र प्रथम"],"answer":1},{"q":"प्रश्न 1818. आदित्य प्रथम द्वारा पल्लवों की पराजय का उल्लेख किस अभिलेख में मिलता है?","en":"","options":["तिरुवालंगाडु लेख","कन्याकुमारी अभिलेख","तंजौर अभिलेख","उत्तरमेरूर अभिलेख"],"answer":1},{"q":"प्रश्न 1819. विजयालय द्वारा तंजौर विजय का वर्णन किस अभिलेख में मिलता है?","en":"","options":["तिरुवालंगाडु ताम्रपत्र","तंजौर अभिलेख","तिस्कोविलूर अभिलेख","कांची अभिलेख"],"answer":2},{"q":"प्रश्न 1820. ‘करैंडै दानपत्र’ किस चोल शासक से संबंधित है?","en":"","options":["राजराज प्रथम","राजेंद्र प्रथम","परांतक प्रथम","कुलोत्तुंग प्रथम"],"answer":1},{"q":"प्रश्न 1821. किस चोल शासक ने ‘तुलाभर’ एवं ‘हिरण्यगर्भ’ यज्ञ किया था?","en":"","options":["परांतक प्रथम","राजराज प्रथम","राजेंद्र प्रथम","आदित्य प्रथम"],"answer":1},{"q":"प्रश्न 1822. राजेंद्र प्रथम की दक्षिण-पूर्व एशिया विजय का उल्लेख किस अभिलेख में मिलता है?","en":"","options":["तंजौर अभिलेख","तिरुवालंगाडु अभिलेख","कन्याकुमारी अभिलेख","करैंडै दानपत्र"],"answer":1},{"q":"प्रश्न 1823. ‘पेरियपुराण’ के लेखक शेक्किलार को संरक्षण किस चोल शासक ने दिया था?","en":"","options":["राजराज प्रथम","राजेंद्र प्रथम","कुलोत्तुंग प्रथम","परांतक द्वितीय"],"answer":2},{"q":"प्रश्न 1824. बादामी की चौथी गुफा किस धर्म से संबंधित है?","en":"","options":["शैव धर्म","वैष्णव धर्म","बौद्ध धर्म","जैन धर्म"],"answer":3},{"q":"प्रश्न 1825. बादामी में गुफा मंदिरों के निर्माण की शुरुआत किस शासक के समय से हुई थी?","en":"","options":["पुलकेशिन द्वितीय","मंगलेश","कीर्तिवर्मन","विक्रमादित्य प्रथम"],"answer":2},{"q":"प्रश्न 1826. पट्टडकल में निर्मित विरूपाक्ष मंदिर का निर्माण किसके शासनकाल में हुआ था?","en":"","options":["पुलकेशिन द्वितीय","विक्रमादित्य प्रथम","विक्रमादित्य द्वितीय","कीर्तिवर्मन द्वितीय"],"answer":2},{"q":"प्रश्न 1827. विक्रमादित्य षष्ठ ने नर्मदा के तट पर कौन-सा यज्ञ सम्पन्न किया था?","en":"","options":["राजसूय यज्ञ","अश्वमेध यज्ञ","वाजपेय यज्ञ","तुलापुरुषदान यज्ञ"],"answer":3},{"q":"प्रश्न 1828. विक्रमादित्य षष्ठ की राजसभा में ‘विक्रमांकदेवचरित’ के लेखक कौन थे?","en":"","options":["सोमेश्वर","बिल्हण","विज्ञानेश्वर","कल्हण"],"answer":1},{"q":"प्रश्न 1829. ‘मिताक्षरा’ ग्रंथ के लेखक विज्ञानेश्वर किस शासक के दरबार में रहते थे?","en":"","options":["सोमेश्वर द्वितीय","विक्रमादित्य षष्ठ","तैलप द्वितीय","जयसिंह"],"answer":1},{"q":"प्रश्न 1830. ‘मानसोल्लास’ ग्रंथ के लेखक कौन थे?","en":"","options":["बिल्हण","विज्ञानेश्वर","सोमेश्वर तृतीय","विक्रमादित्य षष्ठ"],"answer":2},{"q":"प्रश्न 1831. ‘श्रीपृथ्वीवल्लभ’, ‘सत्याश्रय’ और ‘रणविक्रम’ की उपाधियाँ किसने धारण की थीं?","en":"","options":["पुलकेशिन प्रथम","पुलकेशिन द्वितीय","कीर्तिवर्मन प्रथम","विक्रमादित्य प्रथम"],"answer":0},{"q":"प्रश्न 1832. ऐहोल प्रशस्ति कहाँ स्थित है?","en":"","options":["कर्नाटक के धारवाड़ में","कर्नाटक के बीजापुर जिले में","तमिलनाडु के कांची में","आंध्र प्रदेश के वेंगी में"],"answer":1},{"q":"प्रश्न 1833. बादामी के चालुक्यों की राजभाषा क्या थी?","en":"","options":["संस्कृत","प्राकृत","कन्नड़","तेलुगु"],"answer":2},{"q":"प्रश्न 1834. ऐहोल प्रशस्ति में राजकवि रविकीर्ति ने किस राजा की कीर्ति का वर्णन किया है?","en":"","options":["पुलकेशिन प्रथम","कीर्तिवर्मन प्रथम","पुलकेशिन द्वितीय","विक्रमादित्य प्रथम"],"answer":2},{"q":"प्रश्न 1835. कीर्तिवर्मन को ‘बहु सुवर्ण अग्निष्टोम यज्ञ’ करने वाला किस अभिलेख में कहा गया है?","en":"","options":["ऐहोल प्रशस्ति","महाकूट स्तंभ लेख","नासिक अभिलेख","जूनागढ़ अभिलेख"],"answer":1},{"q":"प्रश्न 1836. विक्रमादित्य द्वितीय द्वारा कांची को तीन बार रौंदने का उल्लेख किस अभिलेख में मिलता है?","en":"","options":["ऐहोल प्रशस्ति","महाकूट स्तंभ लेख","पट्टडकल लेख","बादामी शिलालेख"],"answer":2},{"q":"प्रश्न 1837. ‘विजयेश्वर’ मंदिर का निर्माण किसने कराया था?","en":"","options":["पुलकेशिन द्वितीय","विजयादित्य","विक्रमादित्य द्वितीय","कीर्तिवर्मन द्वितीय"],"answer":1},{"q":"प्रश्न 1838. विक्रमादित्य VI के किस अभिलेख में कहा गया है कि 59 चालुक्य राजाओं ने अयोध्या में राज्य किया, फिर वे दक्षिण चले गए थे?","en":"","options":["ऐहोल लेख","महाकूट स्तंभ लेख","केयूर लेख","पट्टडकल लेख"],"answer":2},{"q":"प्रश्न 1839. 1076 ई. में ‘चालुक्य विक्रम संवत’ का प्रचलन किसने कराया था?","en":"","options":["सोमेश्वर प्रथम","तैलप II","विक्रमादित्य VI","जयसिंह"],"answer":2},{"q":"प्रश्न 1840. ‘भूलोक मल्लवर्ष’ नामक संवत चलाने तथा ‘भूलोकमल्ल’ व ‘त्रिभुवनमल्ल’ की उपाधियाँ धारण करने वाला शासक कौन था?","en":"","options":["सोमेश्वर I","विक्रमादित्य VI","सोमेश्वर III","तैलप II"],"answer":2},{"q":"प्रश्न 1841. ‘विक्रमांकदेवचरित’ के रचयिता बिल्हण तथा ‘मिताक्षरा’ के लेखक विज्ञानेश्वर किसके दरबार में निवास करते थे?","en":"","options":["सोमेश्वर I","विक्रमादित्य VI","सोमेश्वर III","तैलप II"],"answer":1},{"q":"प्रश्न 1842. ‘कुरुसपाल शिलालेख’ में किस राजा के बारे में जानकारी मिलती है?","en":"","options":["सोमेश्वर प्रथम","हर्षगुप्त","महाप्रवरराज","महाशिवगुप्त बालार्जुन"],"answer":0},{"q":"प्रश्न 1843. प्रसिद्ध एकाश्म कैलाश मंदिर कहाँ स्थित है?","en":"","options":["अजन्ता","बादामी","एलोरा","पत्तडकल"],"answer":2},{"q":"प्रश्न 1844. एलोरा के प्रसिद्ध कैलाशनाथ मंदिर का निर्माण किसने कराया था?","en":"","options":["दन्तिदुर्ग","कृष्ण प्रथम","गोविंद तृतीय","अमोघवर्ष प्रथम"],"answer":1},{"q":"प्रश्न 1845. ‘गंगा अवतरण’ का दृश्य कहाँ चित्रित है?","en":"","options":["अजन्ता","एलोरा","मामल्लपुरम्","कांची"],"answer":2},{"q":"प्रश्न 1846. ‘कविराजमार्ग’ नामक कन्नड़ ग्रंथ की रचना किस राष्ट्रकूट शासक ने की थी?","en":"","options":["कृष्ण प्रथम","अमोघवर्ष प्रथम","इन्द्र तृतीय","कृष्ण तृतीय"],"answer":1},{"q":"प्रश्न 1847. राष्ट्रकूट शासक दन्तिदुर्ग ने उज्जैन को जीतकर किस यज्ञ का संपादन किया था?","en":"","options":["अश्वमेध","राजसूय","हिरण्यगर्भ","वाजपेय"],"answer":2},{"q":"प्रश्न 1848. प्रसिद्ध जैन आचार्य गुणभद्र किस राष्ट्रकूट शासक के गुरु थे?","en":"","options":["कृष्ण प्रथम","अमोघवर्ष प्रथम","कृष्ण द्वितीय","इन्द्र तृतीय"],"answer":2},{"q":"प्रश्न 1849. राष्ट्रकूट शासक इन्द्र तृतीय (914–929 ई.) के शासनकाल में कौन-सा विदेशी यात्री भारत आया था?","en":"","options":["फाह्यान","ह्वेनसांग","अलबरूनी","अलमसूदी"],"answer":3},{"q":"प्रश्न 1850. एलोरा की गुफाएँ एवं शैलकृत मंदिर किन-किन धर्मों से संबंधित हैं?","en":"","options":["केवल हिन्दू","हिन्दू एवं जैन","हिन्दू, बौद्ध एवं जैन","केवल बौद्ध"],"answer":2},{"q":"प्रश्न 1851. शैलकृत स्थापत्य का आश्चर्य किसे माना जाता है?","en":"","options":["लिंगराज मंदिर","एलोरा का कैलाश मंदिर","कोणार्क मंदिर","महाबलीपुरम रथ"],"answer":1},{"q":"प्रश्न 1852. हिन्दू, जैन एवं बौद्ध तीनों धर्मों का प्रतिनिधित्व करने वाली गुफाएँ कौन-सी हैं?","en":"","options":["अजन्ता","एलिफेंटा","एलोरा","कार्ले"],"answer":2},{"q":"प्रश्न 1853. राष्ट्रकूट शासक अमोघवर्ष के गुरु कौन थे?","en":"","options":["जिनसेन","शंकराचार्य","नागार्जुन","दण्डिन"],"answer":0},{"q":"प्रश्न 1854. राष्ट्रकूट शासकों ने किस भाषा को राजकीय संरक्षण दिया था?","en":"","options":["संस्कृत","प्राकृत","तमिल","कन्नड़"],"answer":3},{"q":"प्रश्न 1855. राष्ट्रकूट कालीन लेखक एवं उनके ग्रंथों के संबंध में कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["पोन्न — शान्तिपुराण","जिनसेन — आदिपुराण","महावीराचार्य — गणितसार संग्रह","त्रिविक्रम — अजित पुराण"],"answer":3},{"q":"प्रश्न 1856. राष्ट्रकूट कालीन लेखक एवं उनके ग्रंथों के संबंध में कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["हालयुध — कविरहस्य","रन्न — अजित पुराण","दण्डिन— दशकुमारचरित","जिनसेन — शान्तिपुराण"],"answer":3},{"q":"प्रश्न 1857. राष्ट्रकूट कालीन एलोरा की चित्रकला को किस अन्य नाम से जाना जाता है?","en":"","options":["चित्रमहल","रंगमहल","रत्नमहल","कलामहल"],"answer":1},{"q":"प्रश्न 1858. एलिफेंटा गुफा से शैल को काटकर बनाये गये मंदिर एवं चित्रकारियों का संबंध किस राजवंश से है?","en":"","options":["गुप्त","चालुक्य","राष्ट्रकूट","पल्लव"],"answer":2},{"q":"प्रश्न 1859. अमोघवर्ष प्रथम के दरबार में 851 ई. में कौन-सा विदेशी यात्री आया था?","en":"","options":["इत्सिंग","ह्वेनसांग","सुलेमान","अलबरूनी"],"answer":2},{"q":"प्रश्न 1860. ‘गणितसारसंग्रह’ ग्रंथ के लेखक कौन थे, जो अमोघवर्ष के दरबार से संबंधित थे?","en":"","options":["जिनसेन","महावीराचार्य","सकटायन","त्रिविक्रम"],"answer":1},{"q":"प्रश्न 1861. राष्ट्रकूट काल में बौद्ध धर्म का प्रमुख केंद्र कहाँ था?","en":"","options":["नालंदा","विक्रमशिला","कन्हेरी","सारनाथ"],"answer":2},{"q":"प्रश्न 1862. पल्लव कालीन राजनीतिक तथा सांस्कृतिक घटनाओं का विवरण किस ग्रंथ से मिलता है?","en":"","options":["हर्षचरित","अवन्तिसुंदरी कथा","दशकुमारचरित","कादम्बरी"],"answer":1},{"q":"प्रश्न 1863. ‘मत्तविलास प्रहसन’ किसकी प्रसिद्ध रचना है?","en":"","options":["सिंह विष्णु","नरसिंह वर्मन प्रथम","महेन्द्रवर्मन प्रथम","नंदिवर्मन द्वितीय"],"answer":2},{"q":"प्रश्न 1864. प्रसिद्ध संस्कृत लेखक दण्डिन किस राजवंश की सभा को अलंकृत करते थे?","en":"","options":["चोल","पल्लव","चालुक्य","राष्ट्रकूट"],"answer":1},{"q":"प्रश्न 1865. दक्षिण भारत में प्रचलित मंदिर निर्माण शैली ‘द्रविड़ शैली’ को किस अन्य नाम से जाना जाता है?","en":"","options":["नागर शैली","वेसर शैली","मामल्ल शैली","पल्लव शैली"],"answer":2},{"q":"प्रश्न 1866. महाबलीपुरम (मामल्लपुरम) नगर की स्थापना किसने की थी?","en":"","options":["महेन्द्रवर्मन प्रथम","सिंह विष्णु","नरसिंह वर्मन प्रथम","नंदिवर्मन द्वितीय"],"answer":2},{"q":"प्रश्न 1867. 641 ई. में किस चीनी यात्री ने नरसिंह वर्मन से भेंट की थी?","en":"","options":["इत्सिंग","ह्वेनसांग","फाह्यान","सुलेमान"],"answer":1},{"q":"प्रश्न 1868. मामल्लपुरम के प्रसिद्ध गणेश मंदिर का निर्माण किसने कराया था?","en":"","options":["सिंह विष्णु","महेन्द्रवर्मन प्रथम","परमेश्वर वर्मन प्रथम","नरसिंह वर्मन द्वितीय"],"answer":2},{"q":"प्रश्न 1869. मामल्लपुरम में वाराह मंदिर का निर्माण किस पल्लव शासक ने कराया था?","en":"","options":["महेन्द्रवर्मन प्रथम","सिंह विष्णु","नरसिंह वर्मन प्रथम","नंदिवर्मन"],"answer":1},{"q":"प्रश्न 1870. कांची के ‘कैलाशनाथ मंदिर’ तथा महाबलीपुरम के ‘शोर मंदिर’ का निर्माण किसने कराया था?","en":"","options":["महेन्द्रवर्मन प्रथम","नरसिंह वर्मन प्रथम","नंदिवर्मन","नरसिंह वर्मन द्वितीय"],"answer":3},{"q":"प्रश्न 1871. किस पल्लव शासक ने चीन में एक दूतमंडल भेजा तथा चीनी यात्रियों के लिए नागपट्टनम में एक विहार बनवाया था?","en":"","options":["नरसिंह वर्मन द्वितीय","सिंह विष्णु","नरसिंह वर्मन प्रथम","परमेश्वर वर्मन"],"answer":0},{"q":"प्रश्न 1872. किस पल्लव शासक ने कांची में ‘मुक्तेश्वर मंदिर’ तथा ‘वैकुण्ठ पेरुमल मंदिर’ का निर्माण करवाया था?","en":"","options":["नरसिंह वर्मन प्रथम","नंदिवर्मन","महेन्द्रवर्मन प्रथम","परमेश्वर वर्मन"],"answer":1},{"q":"प्रश्न 1873. किस पल्लव शासक को एक तमिल अभिलेख में ‘पल्लवकुलभूषण’ तथा ‘भारद्वाज गोत्रीय’ कहा गया है?","en":"","options":["सिंह विष्णु","नरसिंह वर्मन प्रथम","नंदिवर्मन तृतीय","दन्तिवर्मन"],"answer":3},{"q":"प्रश्न 1874. वेल्लूरपालयम अभिलेख में किस पल्लव नरेश को ‘विष्णु का अवतार’ कहा गया है?","en":"","options":["सिंह विष्णु","नरसिंह वर्मन प्रथम","महेन्द्रवर्मन प्रथम","दन्तिवर्मन"],"answer":3},{"q":"प्रश्न 1875. किस पल्लव नरेश ने अश्वमेध, वाजपेय और अग्निष्टोम यज्ञ किए तथा ‘धर्म महाराज’ की पदवी धारण की थी?","en":"","options":["सिंह विष्णु","महेन्द्रवर्मन प्रथम","नरसिंह वर्मन द्वितीय","शिव स्कन्द वर्मन"],"answer":3},{"q":"प्रश्न 1876. पल्लव शासक महेन्द्रवर्मन के किस ग्रंथ में कापालिक, पाशुपत और बौद्ध भिक्षुओं के प्रचार का उल्लेख मिलता है?","en":"","options":["अवन्तिसुंदरी कथा","मत्तविलास प्रहसन","दशकुमारचरित","काव्यमीमांसा"],"answer":1},{"q":"प्रश्न 1877. पल्लव वास्तुकला के पतन का प्रारंभ किस शैली के पश्चात माना जाता है?","en":"","options":["महामल्ल शैली","राजसिंह शैली","नंदिवर्मन शैली","सिंह विष्णु शैली"],"answer":2},{"q":"प्रश्न 1878. महाबलीपुरम के ‘ईश्वर मंदिर’ का निर्माण किस शैली में हुआ था?","en":"","options":["राजसिंह शैली","नंदिवर्मन शैली","मामल्ल शैली","महेंद्र शैली"],"answer":0},{"q":"प्रश्न 1879. कांची का ‘मुक्तेश्वर मंदिर’ किस शैली से संबंधित है?","en":"","options":["मामल्ल शैली","राजसिंह शैली","नंदिवर्मन शैली","चालुक्य शैली"],"answer":2},{"q":"प्रश्न 1880. नंदिवर्मन शैली को अन्य किस नाम से जाना जाता है?","en":"","options":["राजसिंह शैली","अपरराजित शैली","महामल्ल शैली","वातापी शैली"],"answer":1},{"q":"प्रश्न 1881. महाबलीपुरम का ‘शोर मंदिर’ किस शैली का उत्कृष्ट उदाहरण माना जाता है?","en":"","options":["नंदिवर्मन शैली","राजसिंह शैली","चालुक्य शैली","महेंद्र शैली"],"answer":1},{"q":"प्रश्न 1882. राजसिंह शैली (674–800 ई.) का प्रारंभ किस पल्लव शासक के समय हुआ था?","en":"","options":["महेन्द्रवर्मन प्रथम","नरसिंह वर्मन प्रथम","नंदिवर्मन","नरसिंह वर्मन द्वितीय"],"answer":3},{"q":"प्रश्न 1883. निम्नलिखित में से कौन ‘राजसिंह शैली’ का उदाहरण नहीं है?","en":"","options":["कैलाशनाथ मंदिर, कांची","शोर मंदिर, महाबलीपुरम","वैकुण्ठ पेरुमल मंदिर, कांची","महाबलीपुरम का रथ मंदिर"],"answer":3},{"q":"प्रश्न 1884. निम्नलिखित में से कौन ‘नंदिवर्मन (अपराजित) शैली’ का उदाहरण नहीं है?","en":"","options":["मुक्तेश्वर मंदिर, कांची","मातंगेश्वर मंदिर, कांची","कैलाशनाथ मंदिर, कांची","गुडिमल्लम का परशुरामेश्वर मंदिर"],"answer":2},{"q":"प्रश्न 1885. काँची के कैलाशनाथ मंदिर के संबंध में निम्नलिखित में से कौन-सा कथन असत्य है?","en":"","options":["कैलाशनाथ मंदिर कांची में स्थित है।","यह राजसिंह शैली का प्रतिनिधित्व करता है।","यह पल्लव काल का सबसे अलंकृत मंदिर है।","इसका निर्माण नंदिवर्मन ने कराया था।"],"answer":3},{"q":"प्रश्न 1886. काँची का कैलाशनाथ मंदिर किस शैली का प्रतिनिधित्व करता है?","en":"","options":["राजसिंह शैली","मामल्ल शैली","नंदिवर्मन शैली","महेंद्र शैली"],"answer":0},{"q":"प्रश्न 1887. किस तमिल कवि ने मगध साम्राज्य के नन्द और मौर्य राजवंश का उल्लेख किया है?","en":"","options":["कपिलर","अव्वैयार","मामूलनार","नक्कीरर"],"answer":2},{"q":"प्रश्न 1888. किस संगमकालीन ग्रंथ में कोवलन और उसकी पत्नी कन्नगी की कथा मिलती है?","en":"","options":["मणिमेखलै","शिलप्पदिकारम्","जीवक चिंतामणि","तिरुक्कुरल"],"answer":1},{"q":"प्रश्न 1889. संगम कालीन प्रसिद्ध कवि जो श्रीलंका से संबंधित था, वह कौन था?","en":"","options":["कपिलर","राजबाहु","अव्वैयार","नक्कीरर"],"answer":1},{"q":"प्रश्न 1890. ‘पातिकुप्पु’ किस राजवंश के राजाओं की स्तुतिपरक कविताओं का संग्रह है?","en":"","options":["चोल","पाण्ड्य","चेर","पल्लव"],"answer":2},{"q":"प्रश्न 1891. संगम ग्रंथों में उल्लिखित मुरुगन किस देवता से साम्य रखते हैं?","en":"","options":["शिव","विष्णु","स्कन्द","इन्द्र"],"answer":2},{"q":"प्रश्न 1892. ‘शिलप्पदिकारम्’ नामक ग्रंथ में हिमालय तक विजय की चर्चा किस चोल शासक के संदर्भ में की गई है?","en":"","options":["करिकाल","राजराज प्रथम","नेडुंजेलियन","महेन्द्रवर्मन"],"answer":0},{"q":"प्रश्न 1893. अशोक के द्वितीय शिलालेख में चेर का उल्लेख किस अन्य नाम से मिलता है?","en":"","options":["चोल","केरलपुत्र","पाण्ड्य","सातवाहन"],"answer":1},{"q":"प्रश्न 1894. चेर राजवंश का राजकीय चिह्न क्या था?","en":"","options":["मछली","बाघ","धनुष","हाथी"],"answer":2},{"q":"प्रश्न 1895. दक्षिण भारत में किस चेर शासक ने ‘कन्नगी पूजा’ (पत्नी पूजा) प्रारम्भ की थी?","en":"","options":["करिकाल","सेनगुट्टुवन","नेडुंजेलियन","महेन्द्रवर्मन"],"answer":1},{"q":"प्रश्न 1896. किस संगमकालीन तमिल ग्रंथ में पतिव्रता पत्नी-भक्ति का गुणगान किया गया है?","en":"","options":["मणिमेखलै","तिरुक्कुरल","शिलप्पदिकारम्","जीवक चिंतामणि"],"answer":2},{"q":"प्रश्न 1897. पाण्ड्य राज्य का प्रारम्भिक उल्लेख किस ग्रंथ में मिलता है?","en":"","options":["महाभारत","अष्टाध्यायी","अर्थशास्त्र","रामायण"],"answer":1},{"q":"प्रश्न 1898. मेगस्थनीज ने अपनी पुस्तक ‘इंडिका’ में पाण्ड्य राज्य को किस नाम से उल्लिखित किया है?","en":"","options":["सुवर्णभूमि","पाण्ड्यनगर","मावर प्रदेश","द्रविड़ देश"],"answer":2},{"q":"प्रश्न 1899. संगमकालीन पाण्ड्य राजवंश का राजकीय चिह्न क्या था?","en":"","options":["बाघ","धनुष","हाथी","मछली"],"answer":3},{"q":"प्रश्न 1900. संगम परिषद् के अध्यक्ष एवं राजकवि नक्कीरर किस पाण्ड्य शासक के दरबार में निवास करते थे?","en":"","options":["नेडियोन","करिकाल","सेनगुट्टुवन","नेडुंजेलियन"],"answer":3},{"q":"प्रश्न 1901. दक्षिण भारत में रचित संगम साहित्य की मुख्य भाषा क्या थी?","en":"","options":["संस्कृत","प्राकृत","पाली","तमिल"],"answer":3},{"q":"प्रश्न 1902. दक्षिण भारत का आर्यीकरण करने का श्रेय किसे दिया जाता है?","en":"","options":["वशिष्ठ","अगस्त्य","विश्वामित्र","पराशर"],"answer":1},{"q":"प्रश्न 1903. दक्षिण भारत में संगम परिषद् का आयोजन किस राजवंश के संरक्षण में हुआ था?","en":"","options":["चोल","चेर","पाण्ड्य","सातवाहन"],"answer":2},{"q":"प्रश्न 1904. संगम साहित्य का सबसे महत्वपूर्ण महाकाव्य किसे माना जाता है?","en":"","options":["मणिमेखलै","तिरुक्कुरल","जीवक चिंतामणि","शिलप्पदिकारम्"],"answer":3},{"q":"प्रश्न 1905. तमिल साहित्य का ‘बाइबिल’ किस ग्रंथ को माना जाता है?","en":"","options":["मणिमेखलै","तिरुक्कुरल","शिलप्पदिकारम्","तोलकाप्पियम्"],"answer":1},{"q":"प्रश्न 1906. प्रथम संगम की अध्यक्षता किसने की थी?","en":"","options":["वशिष्ठ","अगस्त्य ऋषि","भारद्वाज","वाल्मीकि"],"answer":1},{"q":"प्रश्न 1907. ‘तोलकाप्पियम्’ ग्रंथ किस विषय से संबंधित है?","en":"","options":["धर्म","राजनीति","व्याकरण","चिकित्सा"],"answer":2},{"q":"प्रश्न 1908. संगम युग में किन राजवंशों के उद्भव एवं विकास का वर्णन मिलता है?","en":"","options":["मौर्य, गुप्त, कुषाण","चोल, चेर, पाण्ड्य","सातवाहन, शक, पल्लव","चालुक्य, राष्ट्रकूट, पल्लव"],"answer":1},{"q":"प्रश्न 1909. संगम कालीन प्रमुख देवता किसे माना जाता है?","en":"","options":["शिव","विष्णु","मुरुगन","ब्रह्मा"],"answer":2},{"q":"प्रश्न 1910. संगम साहित्य की रचनाओं की प्रमुख विषय-वस्तु क्या थी?","en":"","options":["धर्म और दर्शन","व्यापार और उद्योग","प्रेम और युद्ध","कृषि और समाज"],"answer":2},{"q":"प्रश्न 1911. तमिल व्याकरण का सबसे प्राचीन ग्रंथ कौन-सा माना जाता है?","en":"","options":["मणिमेखलै","तिरुक्कुरल","तोलकाप्पियम्","शिलप्पदिकारम्"],"answer":2},{"q":"प्रश्न 1912. संगमकाल में तमिल भाषा में महाभारत का अनुवाद किसने किया था?","en":"","options":["सत्तनार","इलंगो आदिगल","तिरुवल्लुवर","विल्लीपुत्तुरार"],"answer":3},{"q":"प्रश्न 1913. निम्नलिखित में कौन-सा सुमेलित नहीं है?","en":"","options":["शिलप्पदिकारम् — इलंगो आदिगल","तोलकाप्पियम् — तोलकाप्पियर","मणिमेखलै — तिरुवल्लुवर","तिरुक्कुरल — तिरुवल्लुवर"],"answer":2},{"q":"प्रश्न 1914. निम्नलिखित में कौन-सा सुमेलित नहीं है?","en":"","options":["शिलप्पदिकारम् — प्रेम कथा","मणिमेखलै — बौद्ध प्रभाव","तोलकाप्पियम् — व्याकरण","तिरुक्कुरल — युद्ध महाकाव्य"],"answer":3},{"q":"प्रश्न 1915. निम्नलिखित में कौन-सा सुमेलित है?","en":"","options":["प्रथम संगम — मदुरै","द्वितीय संगम — कपाटपुरम्","तृतीय संगम — मदुरै","उपरोक्त सभी"],"answer":3},{"q":"प्रश्न 1916. प्रथम ईसा शताब्दी में मानसून हवाओं की जानकारी किसने दी थी?","en":"","options":["स्ट्रैबो","प्लिनी","हिप्पालस","टॉलेमी"],"answer":2},{"q":"प्रश्न 1917. प्रसिद्ध कवि मयूर भट्ट किसके राजदरबार में रहते थे?","en":"","options":["समुद्रगुप्त","हर्षवर्धन","पुलकेशिन द्वितीय","कुमारगुप्त"],"answer":1},{"q":"प्रश्न 1918. मुंडेश्वरी मंदिर, रामलक्ष्मण मंदिर तथा कन्नौज के संघाराम का निर्माण किस शासक से सम्बद्ध माना जाता है?","en":"","options":["चंद्रगुप्त द्वितीय","हर्षवर्धन","स्कंदगुप्त","धर्मपाल"],"answer":1},{"q":"प्रश्न 1919. हर्षवर्धन काल में नालन्दा विश्वविद्यालय के कुलपति कौन थे?","en":"","options":["धर्मपाल","शीलभद्र","नागार्जुन","दिग्नाग"],"answer":1},{"q":"प्रश्न 1920. किस पूर्व मध्यकालीन उत्तर भारतीय शासक को “हिन्दू काल का अकबर” कहा गया है?","en":"","options":["समुद्रगुप्त","हर्षवर्धन","भोज","यशोधर्मन"],"answer":1},{"q":"प्रश्न 1921. सम्राट हर्षवर्धन ने महान धार्मिक सम्मेलनों का आयोजन किन दो स्थानों पर किया था?","en":"","options":["पाटलिपुत्र व नालन्दा","कन्नौज व प्रयाग","उज्जैन व काशी","वैशाली व राजगृह"],"answer":1},{"q":"प्रश्न 1922. बोधिवृक्ष को नष्ट करने वाला शासक कौन माना जाता है?","en":"","options":["पुष्यमित्र शुंग","शशांक","शीलदत्त","मिहिरभोज"],"answer":1},{"q":"प्रश्न 1923. हर्ष द्वारा प्रतिवर्ष महामोक्ष परिषद का आयोजन किस क्षेत्र में किया जाता था?","en":"","options":["काशी","पाटलिपुत्र","प्रयाग","नालन्दा"],"answer":2},{"q":"प्रश्न 1924. हर्षवर्धन को किस अभिलेख में ‘परमसौगत’ कहा गया है?","en":"","options":["ऐहोल अभिलेख","प्रयाग प्रशस्ति","बाँसखेड़ा लेख","जूनागढ़ लेख"],"answer":2},{"q":"प्रश्न 1925. हर्षवर्धन के आध्यात्मिक गुरु कौन थे?","en":"","options":["शीलभद्र","धर्मपाल","वसुबन्धु","गुणप्रभु"],"answer":3},{"q":"प्रश्न 1926. हर्षकालीन कन्नौज धर्म महासभा की अध्यक्षता किसने की थी?","en":"","options":["बाणभट्ट","ह्वेनसांग","इत्सिंग","धर्मकीर्ति"],"answer":1},{"q":"प्रश्न 1927. कन्नौज की धर्म महासभा में ह्वेनसांग को कौन-सी उपाधियाँ प्रदान की गई थीं?","en":"","options":["धर्मरक्षक व बोधिसत्व","महायान देव तथा मोक्षदेव","आचार्य व महामहिम","धर्मपाल व भिक्षुश्रेष्ठ"],"answer":1},{"q":"प्रश्न 1928. पूर्व मध्यकालीन महायान बौद्ध धर्म की शिक्षा का प्रमुख केन्द्र कहाँ स्थित था?","en":"","options":["तक्षशिला","विक्रमशिला","नालन्दा","वल्लभी"],"answer":2},{"q":"प्रश्न 1929. महाराज दृढ़वर्मा की कन्या प्रियदर्शिका की प्रणय कथा किस ग्रंथ में संकलित है?","en":"","options":["नागानन्द","प्रियदर्शिका","रत्नावली","हर्षचरित"],"answer":1},{"q":"प्रश्न 1930. हर्षकालीन शास्त्रीय नाट्य विधा की दृष्टि से सर्वाधिक महत्वपूर्ण नाटक कौन-सा है?","en":"","options":["नागानन्द","रत्नावली","प्रियदर्शिका","मृच्छकटिक"],"answer":1},{"q":"प्रश्न 1931. प्रणय नाटकों के निर्माता के रूप में किस शासक का नाम विशेष रूप से प्रसिद्ध है?","en":"","options":["समुद्रगुप्त","हर्षवर्धन","भोज","विक्रमादित्य"],"answer":1},{"q":"प्रश्न 1932. किस ग्रंथ में वर्धन वंश की तुलना सूर्य से तथा मौखरी वंश की तुलना चन्द्र से की गई है?","en":"","options":["हर्षचरित","राजतरंगिणी","कादम्बरी","कुमारसंभव"],"answer":0},{"q":"प्रश्न 1933. मधुबन ताम्रपत्र लेख (631 ई.) किस शासक कालीन महत्वपूर्ण स्रोत है?","en":"","options":["समुद्रगुप्त","हर्षवर्धन","कुमारगुप्त","पुलकेशिन द्वितीय"],"answer":1},{"q":"प्रश्न 1934. निम्नलिखित में से कौन वर्धन वंश के इतिहास का साहित्यिक स्रोत नहीं है?","en":"","options":["हर्षचरित","कादम्बरी","राजतरंगिणी","प्रियदर्शिका"],"answer":2},{"q":"प्रश्न 1935. निम्नलिखित में से कौन वर्धन वंश की जानकारी का अभिलेखीय स्रोत नहीं है?","en":"","options":["मधुबन ताम्रपत्र","नोसारी ताम्रपत्र","प्रयाग प्रशस्ति","बाँसखेड़ा लेख"],"answer":2},{"q":"प्रश्न 1936. बाणभट्ट ने हर्षचरित ग्रंथ में किस शासक को हूणहरिणकेसरी तथा सिन्धुराजज्वर उपाधियों से संबोधित किया है?","en":"","options":["पुष्यभूति","प्रभाकरवर्धन","राज्यवर्धन","हर्षवर्धन"],"answer":1},{"q":"प्रश्न 1937. प्रभाकरवर्धन का प्रसिद्ध राजवैद्य कौन था?","en":"","options":["जीवक","सुश्रुत","(c सुषेण","धन्वन्तरि"],"answer":2},{"q":"प्रश्न 1938. हर्ष संवत् किसके द्वारा चलवाया गया था?","en":"","options":["राज्यवर्धन","प्रभाकरवर्धन","हर्षवर्धन","पुलकेशिन द्वितीय"],"answer":2},{"q":"प्रश्न 1939. हर्ष के शासनकाल में भारत की यात्रा करने वाला चीनी यात्री कौन था?","en":"","options":["फाह्यान","इत्सिंग","ह्वेनसांग","सुलेमान"],"answer":2},{