async function syncRevisionProgress(){
 if(!remoteProgressReady)return;
 if(remoteProgressBusy){remoteProgressAgain=true;return;}
 remoteProgressBusy=true;
 try{
  const body={performance:performanceData||{questions:{},recent:[],history:[]},session:buildRevisionSession()};
  const response=await fetch('/api/revision-progress',{method:'PUT',credentials:'include',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
