िक्कों पर पाशुपत सम्प्रदाय का प्राचीनतम अंकन मिलता है?","en":"","options":["कनिष्क","विम कडफिसेस","हुविष्क","हर्षवर्धन"],"answer":2},{"q":"प्रश्न 1609. निम्नलिखित में से कौन-सा शैव सम्प्रदाय सबसे पहले अस्तित्व में आया?","en":"","options":["कापालिक","कालमुख","पाशुपत","सिद्धान्त"],"answer":2},{"q":"प्रश्न 1610. पाशुपत सम्प्रदाय की स्थापना किसने की थी?","en":"","options":["कपिल","लकुलीश","वसुगुप्त","कालिदास"],"answer":1},{"q":"प्रश्न 1611. पाशुपत मत के अनुयायी किस नाम से जाने जाते थे?","en":"","options":["नागरक","पाञ्चार्थिक","कालमुख","सिद्ध"],"answer":1},{"q":"प्रश्न 1612. कापालिक सम्प्रदाय के अनुयायी किसे अपना इष्टदेव मानते थे?","en":"","options":["विष्णु","स्कन्द","भैरव","रुद्र"],"answer":2},{"q":"प्रश्न 1613. भवभूति की कृति ‘मालतीमाधव’ में कापालिकों का प्रमुख केन्द्र किस स्थान को माना गया है?","en":"","options":["उज्जैन","काशी","श्रीशैल","बद्रीनाथ"],"answer":2},{"q":"प्रश्न 1614. आदि शंकराचार्य द्वारा स्थापित चार मठों एवं उनके स्थान के संबंध में निम्न युग्मों में से कौन-सा सुमेलित नहीं है?","en":"","options":["शारदा पीठ — द्वारका","ज्योतिर्मठ — बद्रीनाथ","गोवर्धन पीठ — पुरी","श्रृंगेरी मठ — कांची"],"answer":3},{"q":"प्रश्न 1615. योग में इन्द्रियों का उनके विषयों से लौटना कहलाता है —","en":"","options":["प्राणायाम","प्रत्याहार","धारणा","ध्यान"],"answer":1},{"q":"प्रश्न 1616. योगसूत्र के अनुसार निम्नलिखित में से कौन-सा ‘यम’ नहीं है?","en":"","options":["संतोष","अहिंसा","सत्य","अस्तेय"],"answer":0},{"q":"प्रश्न 1617. इनमें से कौन-सा एक अष्टांगिक मार्ग में नहीं है?","en":"","options":["सम्यक् दृष्टि","सम्यक् संकल्प","सम्यक् वाक्","सम्यक् भावना"],"answer":3},{"q":"प्रश्न 1618. इनमें से कौन-सा एक वैदिक ऋण नहीं है?","en":"","options":["देव ऋण","पितृ ऋण","प्रकृति ऋण","ऋषि ऋण"],"answer":2},{"q":"प्रश्न 1619. ‘संवर’ सम्बन्धित है :","en":"","options":["जैन से","बौद्ध से","चार्वाक से","वेदांत से"],"answer":0},{"q":"प्रश्न 1620. ‘त्रिपिटक’ लिखी गई है :","en":"","options":["संस्कृत में","प्राकृत में","पालि में","अपभ्रंश में"],"answer":2},{"q":"प्रश्न 1621. ‘लेश्या’ के सिद्धान्त का विवेचन किया गया है :","en":"","options":["चार्वाक में","जैन में","सांख्य में","उपर्युक्त में से कोई नहीं"],"answer":1},{"q":"प्रश्न 1622. ‘नव-बौद्धवाद’ में बोधिसत्व की विशेषता क्या है?","en":"","options":["दूसरों की मुक्ति का प्रयास करना","सभी की समानता हेतु लड़ना","मानवता की सेवा का जीवनव्रत लेना","उपर्युक्त में से कोई नहीं"],"answer":2},{"q":"प्रश्न 1623. ‘दी बुद्ध एंड कार्ल मार्क्स’ किसकी रचना है?","en":"","options":["विवेकानन्द","जे. कृष्णमूर्ति","अम्बेडकर","गांधी"],"answer":2},{"q":"प्रश्न 1624. इनमें से कौन-सा एक सही क्रम में है?","en":"","options":["अर्थ, काम, धर्म, मोक्ष","धर्म, काम, अर्थ, मोक्ष","धर्म, अर्थ, काम, मोक्ष","अर्थ, धर्म, काम, मोक्ष"],"answer":2},{"q":"प्रश्न 1625. मैत्री, मुदिता, करुणा एवं उपेक्षा का संबंध है :","en":"","options":["जैन दर्शन से","मीमांसा दर्शन से","बौद्ध दर्शन से","योग से"],"answer":2},{"q":"प्रश्न 1626. अपूर्व के सिद्धान्त का संबंध है -","en":"","options":["चार्वाक से","मीमांसा से","जैन से","न्याय से"],"answer":1},{"q":"प्रश्न 1627. ‘अहं ब्रह्मास्मि’ किस दर्शन का केंद्रीय कथन है?","en":"","options":["सांख्य","योग","वेदांत","मीमांसा"],"answer":2},{"q":"प्रश्न 1628. बुद्धिस्ट इंडिया नामक ग्रंथ के लेखक कौन हैं?","en":"","options":["डब्ल्यू जी ग्रोथ","टी. डब्ल्यू. रीस डेविड्स","भीमराव अंबेडकर","डेविड रिडले"],"answer":1},{"q":"प्रश्न 1629. कांची का कैलाशनाथ मंदिर किस शैली में बना है?","en":"","options":["राजसिंह शैली","महेन्द्र शैली","मामल्ल शैली","नंदीवर्मन शैली"],"answer":0},{"q":"प्रश्न 1630. मधुबन एवं वंसखेड़ा ताम्रलेख किस शासक द्वारा जारी किए गए थे?","en":"","options":["धर्मपाल","हर्ष","तोरमाण","कृष्ण तृतीय"],"answer":1},{"q":"प्रश्न 1631. खलीमपुर ताम्रलेख में किस पाल शासक की उपलब्धियों का अलंकारिक वर्णन मिलता है?","en":"","options":["गोपाल","धर्मपाल","देवपाल","महेन्द्रपाल"],"answer":1},{"q":"प्रश्न 1632. आमकोरा ताम्रपत्र से किस नपाल शासक का अस्तित्व प्रमाणित हुआ है?","en":"","options":["देवपाल","गोपाल","महेन्द्रपाल","धर्मपाल"],"answer":2},{"q":"प्रश्न 1633. करहाटक ताम्रलेख किस राष्ट्रकूट शासक से संबंधित है?","en":"","options":["अमोघवर्ष","ध्रुव","कृष्ण तृतीय","गोविंद तृतीय"],"answer":2},{"q":"प्रश्न 1634. संजेली ताम्रपत्र किस हूण शासक से संबंधित है?","en":"","options":["मिहिरकुल","तोरमाण","स्कंदगुप्त","हूणराज"],"answer":1},{"q":"प्रश्न 1635. नासिक गुफा प्रशस्ति में किस शासक की उपलब्धियों का वर्णन किया गया है?","en":"","options":["रुद्रदामन","गौतमीपुत्र सातकर्णि","पुलुमावी","यशोवर्मन"],"answer":1},{"q":"प्रश्न 1636. किस प्रशस्ति में गौतमीपुत्र सातकर्णि को ‘क्षत्रिय दर्प मानमर्द’ कहा गया है?","en":"","options":["हाथीगुफा लेख","जूनागढ़ लेख","नासिक गुफा प्रशस्ति","प्रयाग प्रशस्ति"],"answer":2},{"q":"प्रश्न 1637. नंदिकलंबकम् नामक प्रशस्ति की रचना किस पल्लव शासक से संबंधित है?","en":"","options":["महेन्द्रवर्मन","नरसिंहवर्मन","राजसिंह","नंदिवर्मन तृतीय"],"answer":3},{"q":"प्रश्न 1638. स्कंदगुप्त की काव्यमयी प्रशस्ति किस स्तंभलेख में मिलती है?","en":"","options":["इलाहाबाद स्तंभलेख","ग्वालियर प्रशस्ति","भीतरी स्तंभलेख","देवपाड़ा प्रशस्ति"],"answer":2},{"q":"प्रश्न 1639. रुद्रदामन का जूनागढ़ लेख किस भाषा में लिखा गया था?","en":"","options":["प्राकृत","पालि","अपभ्रंश","संस्कृत"],"answer":3},{"q":"प्रश्न 1640. उदयपुर प्रशस्ति किस वंश से संबंधित मानी जाती है?","en":"","options":["गुप्त वंश","पल्लव वंश","परमार वंश","पुष्यभूति वंश"],"answer":2},{"q":"प्रश्न 1641. नासिक गुफा प्रशस्ति को किसने उत्कीर्ण कराया था?","en":"","options":["गौतमीपुत्र शातकर्णी","गौतमी बलश्री","वशिष्टिपुत्र पुलवामी","आमात्यधर"],"answer":1},{"q":"प्रश्न 1642. मंदसौर प्रशस्ति के संदर्भ में कौन-सा कथन असत्य है?","en":"","options":["यह यशोवर्मन से संबंधित है।","इसका लेखक वासुल था।","इसमें मिहिरकुल का उल्लेख मिलता है।","इसका संबंध समुद्रगुप्त से है।"],"answer":3},{"q":"प्रश्न 1643. ग्वालियर प्रशस्ति के बारे में कौन-सा कथन असत्य है?","en":"","options":["यह मिहिरभोज से संबंधित है।","इसका कवि बालादित्य था।","यह विष्णु-स्तुति से आरंभ होती है।","इसमें स्कन्दगुप्त का उल्लेख मिलता है"],"answer":3},{"q":"प्रश्न 1644. ऐहोल प्रशस्ति के बारे में कौन-सा कथन असत्य है?","en":"","options":["यह पुलकेशिन द्वितीय से संबंधित है।","यह मेगुति नामक जैन मंदिर से प्राप्त हुई थी।","यह पल्लव शासकों की प्रशस्ति है।","इसमें समुद्रगुप्त की उपलब्धियों का वर्णन है"],"answer":3},{"q":"प्रश्न 1645. तालगुंड प्रशस्ति किससे संबंधित है?","en":"","options":["मयूरशर्मा","शान्तिवर्मा","काकुत्सवर्मा","रविवर्मा"],"answer":1},{"q":"प्रश्न 1646. समुद्रगुप्त की इलाहाबाद स्तंभलेख प्रशस्ति को किस नाम से भी जाना जाता है?","en":"","options":["मंदसौर प्रशस्ति","प्रयाग प्रशस्ति","देवपाड़ा प्रशस्ति","ग्वालियर प्रशस्ति"],"answer":1},{"q":"प्रश्न 1647. निम्नलिखित में से कौन-सा युग्म सुमेलित नहीं है?","en":"","options":["प्रयाग प्रशस्ति — समुद्रगुप्त","जूनागढ़ लेख — रुद्रदमन","ग्वालियर प्रशस्ति — कुमारपाल","मंदसौर प्रशस्ति — यशोवर्मन"],"answer":2},{"q":"प्रश्न 1648. देवपाड़ा प्रशस्ति के लेखक किस व्यक्ति को माना जाता है?","en":"","options":["बालादित्य","उमापतिधर","वासुल","श्रीपाल"],"answer":1},{"q":"प्रश्न 1649. हाथीगुफा लेख किस शासक से संबंधित है?","en":"","options":["रुद्रदमन","खारवेल","समुद्रगुप्त","मिहिरभोज"],"answer":1},{"q":"प्रश्न 1650. भीतरी स्तंभ लेख किस शासक से संबंधित है?","en":"","options":["समुद्रगुप्त","चंद्रगुप्त द्वितीय","स्कंदगुप्त","कुमारगुप्त"],"answer":2},{"q":"प्रश्न 1651. जिस मिहिरकुल ने शिव के अतिरिक्त अन्य किसी के सामने सिर न झुकाया; उससे यशोवर्मन ने अपनी चरण-वंदना कराई।” — यह कथन किस प्रशस्ति में मिलता है?","en":"","options":["ग्वालियर प्रशस्ति","उदयपुर प्रशस्ति","तालगुंड प्रशस्ति","मंदसौर प्रशस्ति"],"answer":3},{"q":"प्रश्न 1652. देवपाड़ा प्रशस्ति में किस वंश के शासकों का उल्लेख मिलता है?","en":"","options":["पाल वंश","सेन वंश","राष्ट्रकूट वंश","प्रतिहार वंश"],"answer":1},{"q":"प्रश्न 1653. उदयपुर प्रशस्ति किस परमार शासक से संबंधित है?","en":"","options":["भोज","उदयादित्य","वाक्पति","सिंहराज"],"answer":1},{"q":"प्रश्न 1654. उदयपुर प्रशस्ति किस मंदिर के शिलापट्ट पर अंकित है?","en":"","options":["सोमनाथ मंदिर","नीलकंठेश्वर मंदिर","कोणार्क सूर्य मंदिर","चर्तुभुज मंदिर"],"answer":1},{"q":"प्रश्न 1655. बोगाजकोई अभिलेख की खोज किसने की थी?","en":"","options":["कनिंघम","जॉन मार्शल","वीकलर","फ्लीट"],"answer":2},{"q":"प्रश्न 1656. बोगाजकोई अभिलेख किस लिपि में लिखा गया है?","en":"","options":["ब्राह्मी","खरोष्ठी","कीलाक","नागरी"],"answer":2},{"q":"प्रश्न 1657. बोगाजकोई अभिलेख में किन देवताओं का उल्लेख मिलता है?","en":"","options":["ब्रह्मा, विष्णु, महेश, अग्नि","इन्द्र, मित्र, वरुण, नासत्य","सूर्य, चन्द्र, अग्नि, विष्णु","शिव, पार्वती, गणेश, ब्रम्हा"],"answer":1},{"q":"प्रश्न 1658. देवपाड़ा प्रशस्ति के लेखक उमापतिधर किस शासक के राजकवि थे?","en":"","options":["लक्ष्मणसेन","विजयसेन","धर्मपाल","गोपाल"],"answer":1},{"q":"प्रश्न 1659. बोगाजकोई अभिलेख के संबंध में निम्नलिखित कथनों में से कौन सा कथन असत्य है?","en":"","options":["बोगाजकोई अभिलेख एशिया माइनर (तुर्की) में है।","इस अभिलेख की खोज वीकलर ने की थी।","इसे ब्राह्मी लिपि में लिखा गया है।","इसमें इन्द्र, मित्र, वरुण और नासत्य का उल्लेख है।"],"answer":2},{"q":"प्रश्न 1660. किस अभिलेख में कनिष्क द्वितीय को ‘कैसर' की उपाधि दी गई है?","en":"","options":["हुंजा अभिलेख","आरा अभिलेख","नानाघाट अभिलेख","रबातक अभिलेख"],"answer":1},{"q":"प्रश्न 1661. किस अभिलेख में कनिष्क द्वितीय को ‘कैसर' की उपाधि दी गई है?","en":"","options":["हुंजा अभिलेख","आरा अभिलेख","नानाघाट अभिलेख","रबातक अभिलेख"],"answer":1},{"q":"प्रश्न 1662. किस अभिलेख से ज्ञात होता है कि विम कडफिसेस और कनिष्क पिता-पुत्र थे?","en":"","options":["आरा अभिलेख","रबातक अभिलेख","नानाघाट अभिलेख","जूनागढ अभिलेख"],"answer":1},{"q":"प्रश्न 1663. किस अभिलेख को ‘चित्र-फलक-अभिलेख’ भी कहा जाता है?","en":"","options":["जूनागढ़ अभिलेख","नानाघाट अभिलेख","रबातक अभिलेख","भीतरी स्तम्भ लेख"],"answer":1},{"q":"प्रश्न 1664. ब्राह्मणों एवं बौद्धों को भूमि दान दिए जाने का प्रथम प्रमाण कहाँ मिलता है?","en":"","options":["नानाघाट अभिलेख","हुंजा अभिलेख","रबातक अभिलेख","हाथीगुफ़ा अभिलेख"],"answer":0},{"q":"प्रश्न 1665. किस अभिलेख में ‘कनिष्क संवत’ का उल्लेख मिलता है?","en":"","options":["आरा अभिलेख","रबातक अभिलेख","नानाघाट अभिलेख","ग्वालियर प्रशस्ति"],"answer":1},{"q":"प्रश्न 1666. किस अभिलेख में शातकर्णि प्रथम द्वारा 18 यज्ञ संपन्न करने का उल्लेख मिलता है?","en":"","options":["नानाघाट अभिलेख","जूनागढ़ अभिलेख","हुंजा अभिलेख","हाथीगुफ़ा अभिलेख"],"answer":0},{"q":"प्रश्न 1667. किस अभिलेख में कुषाणों की वंशावली का उल्लेख मिलता है?","en":"","options":["बोगजोगोई अभिलेख","हुंजा अभिलेख","रबातक अभिलेख","आरा अभिलेख"],"answer":2},{"q":"प्रश्न 1668. किस अभिलेख में शातकर्णि प्रथम द्वारा 18 यज्ञ संपन्न करने का उल्लेख मिलता है?","en":"","options":["नानाघाट अभिलेख","ऐहोल अभिलेख","सोहगौरा अभिलेख","भीतरी अभिलेख"],"answer":0},{"q":"प्रश्न 1669. जूनागढ़ अभिलेख में निम्नलिखित में से किस कर का उल्लेख नहीं मिलता है?","en":"","options":["बलि","भाग","शुल्क","भोग"],"answer":3},{"q":"प्रश्न 1670. जूनागढ़ अभिलेख में कितने प्रकार के करों का उल्लेख मिलता है?","en":"","options":["चार","पाँच","छह","सात"],"answer":2},{"q":"प्रश्न 1671. शक महाक्षत्रप रुद्रदामन के जूनागढ़ अभिलेख की खोज किसने की थी?","en":"","options":["कनिंघम","जेम्स प्रिन्सेप","फ्लीट","जॉन मार्शल"],"answer":1},{"q":"प्रश्न 1672. जूनागढ़ अभिलेख किस शासक से संबंधित है?","en":"","options":["अशोक","रुद्रदामन","चंद्रगुप्त मौर्य","समुद्रगुप्त"],"answer":1},{"q":"प्रश्न 1673. किस अभिलेख में चंद्रगुप्त मौर्य और अशोक का एक साथ उल्लेख मिलता है?","en":"","options":["प्रयाग प्रशस्ति","जूनागढ़ अभिलेख","ग्वालियर प्रशस्ति","हाथीगुम्फा अभिलेख"],"answer":1},{"q":"प्रश्न 1674. जूनागढ़ अभिलेख किस शैली में लिखा गया पहला अभिलेख माना जाता है?","en":"","options":["गद्य शैली","पद्य शैली","चम्पू शैली","सूत्र शैली"],"answer":2},{"q":"प्रश्न 1675. जूनागढ़ अभिलेख को किस भाषा में है?","en":"","options":["प्राकृत","पालि","संस्कृत","ग्रीक"],"answer":2},{"q":"प्रश्न 1676. चंद्रगुप्त मौर्य के नाम का उल्लेख करने वाला एकमात्र अभिलेखीय साक्ष्य कौन सा है?","en":"","options":["प्रयाग प्रशस्ति","जूनागढ़ अभिलेख","ऐहोल अभिलेख","हाथीगुम्फा अभिलेख"],"answer":1},{"q":"प्रश्न 1677. जूनागढ़ लेख में किस शासक का उल्लेख नही मिलता हैं?","en":"","options":["अशोक","चंद्रगुप्त मौर्य","स्कन्दगुप्त","कुमारगुप्त"],"answer":3},{"q":"प्रश्न 1678. रुद्रदामन ने सुदर्शन झील का पुनर्निर्माण किसके माध्यम से करवाया था?","en":"","options":["चक्रपालित","पुष्यगुप्त","सुविशाख","तुषास्फ"],"answer":2},{"q":"प्रश्न 1679. 