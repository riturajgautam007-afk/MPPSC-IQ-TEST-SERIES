 return {activeUnit:Number(activeUnit)||2,isMixedMode:!!isMixedMode,isUnitShuffled:!!isUnitShuffled,questionOrder:order,answers:safeAnswers,currentIndex:Math.max(0,Math.min(30000,Number(currentIndex)||0)),savedAt:Date.now()};
